{
  "name": "vampire-backend",
  "version": "1.0.0",
  "private": true,
  "node": ">=24.0.0",
  "scripts": {
    "dev-win": "set NODE_ENV=development && run-p dev:1 dev:2",
    "dev": "NODE_ENV=development run-p dev:1 dev:2",
    "dev:1": "tsc --watch --preserveWatchOutput -p tsconfig.dev.json",
    "dev:2": "wait-on dev/main.js && nodemon -q --watch dev/ dev/main.js",
    "build": "run-s tsoa:spec tsoa:routes type-check build-only test",
    "build-only": "tsc",
    "type-check": "tsc --noEmit --composite false",
    "migrate:make": "knex migrate:make -x ts",
    "run": "node dist/main.js",
    "test": "jest --rootDir src/ --passWithNoTests",
    "tsoa:spec": "npm exec tsoa spec",
    "tsoa:routes": "npm exec tsoa routes"
  },
  "dependencies": {
    "ajv-formats": "^3.0.1",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "express": "^5.0.0",
    "express-session": "^1.18.0",
    "filewatcher": "^3.0.1",
    "glob": "^14.0.0",
    "knex": "^3.1.0",
    "mysql2": "^3.9.7",
    "objection": "^3.1.4",
    "sqlite3": "^6.0.0",
    "typescript-ioc": "^3.2.2"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.13.4",
    "@rushstack/eslint-patch": "^1.10.3",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.0.0",
    "jest": "^30.0.0",
    "nodemon": "^3.1.0",
    "npm-run-all2": "^9.0.0",
    "ts-jest": "^29.1.3",
    "tsoa": "^6.2.1",
    "typescript": "^7.0.0",
    "wait-on": "^9.0.0"
  },
  "allowScripts": {
    "@openapitools/openapi-generator-cli": true,
    "@parcel/watcher": true,
    "bcrypt": true,
    "sqlite3": true
  }
}
